# ---- Go 编译产物 ----
# 注意要用 / 锚在仓库根上：裸写 giftbook 会连 cmd/giftbook/ 这个目录一起排除掉，
# 整个程序入口就进不了仓库。
/giftbook
/giftbook.exe
/giftbook.exe~
/giftbook-linux-*
/giftbook-darwin-*
/giftbook-windows-*
/build/

# ---- 前端（自研原生 JS/CSS）----
# ui/ 由 embed.go 的 //go:embed all:ui 直接嵌入二进制，是源码、必须入库。
# 没有构建产物目录，也不需要 npm / Vite；旧版 Vue 前端（web/）与产物（webapp/）已删除。

# ---- 运行数据（含真实礼金记录，绝不入库）----
/data/
/config/
/rundata/
/backups/
*.log

# ---- 本地调试产物 ----
/.shots*/
/.edge-profile/
# 无头浏览器的用户数据目录，动辄几百 MB，且含 Cookie
/.edge*/
/.vite*
/.tmp-*

# ---- OCR 第三方产物（不入库，按各自许可证单独获取）----
# 模型与 Python 依赖是第三方作品，体积大且各有许可，绝不能提交进本仓库。
# 清单与分发注意事项见 ocr/THIRD_PARTY.md。
/ocr/models/
/ocr/venv/
/ocr/__pycache__/
/ocr/*.onnx
/ocr/*.tgz
/ocr/*.whl

# ---- 编辑器 / 系统 ----
/.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
