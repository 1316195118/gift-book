# ---- Go 编译产物 ----
# 注意要用 / 锚在仓库根上：裸写 giftbook 会连 cmd/giftbook/ 这个目录一起排除掉，
# 整个程序入口就进不了仓库。
/giftbook
/giftbook.exe
/giftbook.exe~
/giftbook-linux-*
/giftbook-darwin-*
/giftbook-windows-*
/build/

# ---- 前端（Vue 3 + Vite）----
/web/node_modules/
/web/dist/

# 前端产物由构建生成，但目录本身要留着：
# embed.go 的 //go:embed all:webapp/dist 在目录不存在时无法编译。
# 同样要锚在根上，裸写 dist/ 会匹配任意层级的 dist 目录。
/webapp/dist/*
!/webapp/dist/.gitkeep

# ---- 运行数据（含真实礼金记录，绝不入库）----
/data/
/config/
/rundata/
/backups/
*.log

# ---- 本地调试产物 ----
/.shots*/
/.edge-profile/
# 无头浏览器的用户数据目录，动辄几百 MB，且含 Cookie
/.edge*/
/.vite*
/.tmp-*

# ---- OCR 第三方产物（不入库，按各自许可证单独获取）----
# 模型与 Python 依赖是第三方作品，体积大且各有许可，绝不能提交进本仓库。
# 清单与分发注意事项见 ocr/THIRD_PARTY.md。
/ocr/models/
/ocr/venv/
/ocr/__pycache__/
/ocr/*.onnx
/ocr/*.tgz
/ocr/*.whl

# ---- 本地 AI 工作日志（内部记录，不入库）----
/.workbuddy-ai/

# ---- 编辑器 / 系统 ----
/.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# 前端覆盖率报表
web/coverage/
