{
  "name": "giftbook-web",
  "private": true,
  "version": "2.4.67",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "cd .. && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "brand:assets": "cd .. && node scripts/generate-brand-assets.mjs",
    "images:optimize": "cd .. && python scripts/optimize-images.py",
    "security:secrets": "cd .. && node scripts/scan-secrets.mjs",
    "links:check": "cd .. && node scripts/check-links.mjs",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:responsive": "node e2e/responsive.mjs",
    "e2e:custom": "node e2e/custom-template.mjs",
    "e2e:categories": "node e2e/category-settings.mjs",
    "e2e:family-code": "node e2e/family-code.mjs",
    "e2e:admin-family": "node e2e/admin-family.mjs",
    "e2e:article": "node e2e/article-pages.mjs",
    "e2e:insights": "node e2e/insights.mjs",
    "e2e:perf": "node e2e/perf-audit.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.1",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  }
}
